{
  "manifest_version": 3,
  "name": "Суть — расшифровка и поиск по видео",
  "short_name": "Суть",
  "version": "0.2.0",
  "description": "Боковая панель для любого сайта с видео: оглавление, расшифровка и поиск по смыслу из сервиса «Суть» — на сайте или на своём компьютере.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Открыть панель «Суть»" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
